{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threshold",
  "version": "0.1.0",
  "identifier": "app.threshold.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Threshold",
        "width": 1100,
        "height": 780
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
